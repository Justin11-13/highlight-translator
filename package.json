{
  "name": "highlight-translator",
  "productName": "Highlight Translator",
  "version": "1.0.0",
  "description": "Select text anywhere on Windows, get an instant offline translation in a liquid glass popup.",
  "author": "ongzh",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "node scripts/make-icons.mjs",
    "helper": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -STA -File native/SelectionHelper/SelectionHelper.ps1 --selftest --clipboard-fallback",
    "test:helper": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -STA -File scripts/test-hook.ps1",
    "test:translate": "node services/translation/smoke.mjs",
    "shots": "electron scripts/capture.mjs",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.1.0",
    "jimp": "^1.6.0",
    "png-to-ico": "^2.1.8",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.6": true
  }
}
